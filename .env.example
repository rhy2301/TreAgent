# TreAgent 환경변수 템플릿
# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 .gitignore 에 있으므로 커밋되지 않는다.
#   cp .env.example .env

# --------------------------------------------------------------------------- #
# 네트워크
# --------------------------------------------------------------------------- #

SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=devnet

# 자체 발행한 devnet SPL 토큰의 mint 주소.
# 만드는 법 (solana CLI + spl-token CLI 필요):
#   solana config set --url devnet
#   spl-token create-token --decimals 6
#   spl-token create-account <MINT>
#   spl-token mint <MINT> 1000000
# 출력된 mint 주소를 여기에 넣는다. decimals 는 반드시 6 이어야 한다.
# (transfer_checked 가 decimals 를 검증하므로 다르면 전송이 거부된다)
USDC_MINT=

# true 면 온체인 호출 없이 mock_data 로 응답한다.
# 시연 중 RPC 장애나 레이트리밋이 났을 때 되돌아갈 폴백.
MOCK_MODE=false

# --------------------------------------------------------------------------- #
# 트레저리 지갑 4개
# --------------------------------------------------------------------------- #
# 생성:  cd backend && python -m chain.wallet
# 출력된 줄을 그대로 아래에 붙여넣은 뒤, 각 PUBLIC_KEY 로 devnet SOL 을 받는다:
#   solana airdrop 2 <PUBLIC_KEY> --url devnet
#   (또는 https://faucet.solana.com)
#
# PRIVATE_KEY 는 bytes(Keypair) 64바이트의 base58 인코딩이다.
# PUBLIC_KEY 를 비워두면 PRIVATE_KEY 에서 유도한다. 둘 다 적으면 서로 일치하는지
# 검증하며, 어긋나면 잘못된 지갑에서 자금이 나가는 것을 막기 위해 중단한다.

VAULT_PUBLIC_KEY=
VAULT_PRIVATE_KEY=

OPERATIONS_PUBLIC_KEY=
OPERATIONS_PRIVATE_KEY=

PAYROLL_PUBLIC_KEY=
PAYROLL_PRIVATE_KEY=

VENDOR_PUBLIC_KEY=
VENDOR_PRIVATE_KEY=

# --------------------------------------------------------------------------- #
# AI
# --------------------------------------------------------------------------- #

GEMINI_API_KEY=
